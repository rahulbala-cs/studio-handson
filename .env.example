# npm run setup copies this file to .env and fills it in: nothing to edit.
#
# It asks for a stack name and creates that stack in the organization you log in
# to, then writes the values at the bottom of this file.

STACK_NAME=Studio Hands-on - Your Name

# Only if an admin created an EMPTY stack for you: run
#   npm run setup -- --api-key <its API key>
# and setup fills that stack instead of creating one.
NEXT_PUBLIC_CONTENTSTACK_API_KEY=

# ── Defaults (change only if you know why) ────────────────────────────────────
NEXT_PUBLIC_CONTENTSTACK_ENVIRONMENT=preview
# Where Studio loads your site from: the dev server on your laptop.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Written by npm run setup ──────────────────────────────────────────────────
# NEXT_PUBLIC_CONTENTSTACK_REGION=          (us, eu, au, azure-na, azure-eu, gcp-na, gcp-eu)
# NEXT_PUBLIC_CONTENTSTACK_DELIVERY_TOKEN=
# NEXT_PUBLIC_CONTENTSTACK_PREVIEW_TOKEN=   (never set this on a public production site)
# CONTENTSTACK_ENVIRONMENT_UID=
# CS_ORG_UID=
